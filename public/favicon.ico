<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="fuse" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#833AB4"/>
      <stop offset="35%" stop-color="#E1306C"/>
      <stop offset="65%" stop-color="#FF0000"/>
      <stop offset="100%" stop-color="#F77737"/>
    </linearGradient>
  </defs>

  <!-- Background circle -->
  <circle cx="256" cy="256" r="256" fill="#0e0b18"/>

  <!-- Gradient ring -->
  <circle cx="256" cy="256" r="200" fill="none" stroke="url(#fuse)" stroke-width="12"/>

  <!-- Download arrow -->
  <line x1="256" y1="180" x2="256" y2="290" stroke="url(#fuse)" stroke-width="22" stroke-linecap="round"/>
  <polyline points="190,270 256,336 322,270" fill="none" stroke="url(#fuse)" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
  <line x1="188" y1="356" x2="324" y2="356" stroke="url(#fuse)" stroke-width="18" stroke-linecap="round"/>

  <!-- Orbiting dots -->
  <circle cx="256" cy="52"  r="18" fill="#E1306C"/>
  <circle cx="460" cy="168" r="14" fill="#F77737"/>
  <circle cx="460" cy="344" r="14" fill="#FF0000"/>
  <circle cx="52"  cy="168" r="14" fill="#833AB4"/>
  <circle cx="52"  cy="344" r="14" fill="#FCAF45"/>
  <circle cx="256" cy="460" r="18" fill="#FF0000"/>
</svg>
